# Copy to .env and fill in your keys. Do not commit .env.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alpaca — keys must match the environment you use in code:
#   Paper account  → ALPACA_PAPER_TRADE=True  (requests go to paper-api.alpaca.markets)
#   Live account   → ALPACA_PAPER_TRADE=False (requests go to api.alpaca.markets)
# The dashboard may show https://api.alpaca.markets — that is the *live* URL label.
# Paper keys + wrong flag (or vice versa) → HTTP 401.
# Then run: uv run python scripts/sync_mcp_env.py
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_PAPER_TRADE=True

# Gmail SMTP (for run notifications)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords → "Mail"
# 3. Paste the 16-char password below
SMTP_SENDER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
