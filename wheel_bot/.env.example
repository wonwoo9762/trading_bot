# Copy this file to .env and fill in your own values.
# Never commit wheel_bot/.env.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Alpaca
# Paper account keys must use ALPACA_PAPER_TRADE=True.
# Live account keys must use ALPACA_PAPER_TRADE=False.
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_PAPER_TRADE=True

# Execution safety
# Keep auto execution disabled until paper validation is complete.
WHEEL_BOT_RUN_ON_START=False
WHEEL_BOT_AUTO_EXECUTE=False
WHEEL_BOT_ALLOW_LIVE_TRADING=False

# Optional candidate universe override
WHEEL_BOT_CANDIDATE_TICKERS=AAPL,MSFT,GOOGL

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
